# ── Sitio ──────────────────────────────────────────────────────────────
# URL pública final (para Open Graph, sitemap y canonical).
NEXT_PUBLIC_SITE_URL=https://brasil2027.ejemplo.edu.ar

# Correo de contacto del equipo organizador (se muestra en FAQ, footer y aviso de privacidad).
NEXT_PUBLIC_CONTACT_EMAIL=

# Área o persona responsable del tratamiento de datos (aviso de privacidad).
NEXT_PUBLIC_RESPONSABLE_DATOS=

# Plazo de conservación de los datos (texto). Por defecto: "el 31 de diciembre de 2027".
NEXT_PUBLIC_CONSERVACION_HASTA=

# ── Base de datos (Supabase) ───────────────────────────────────────────
# Sin estas dos variables, en desarrollo se usa .data/interesados.json y en producción el formulario responde error.
# La service_role key SOLO va en el servidor: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Panel de administración (/admin) ───────────────────────────────────
ADMIN_PASSWORD=
# Cadena aleatoria de 32+ caracteres. Generar con: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# ── Anti-spam opcional: Cloudflare Turnstile ───────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analítica opcional: Plausible (sin cookies, se carga solo con consentimiento) ──
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
